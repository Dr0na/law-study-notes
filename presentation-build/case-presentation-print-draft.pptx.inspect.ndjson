{"kind":"textbox","id":"sh/xwnqtc7m","slideIndex":2,"position":{"left":158,"top":386,"width":470,"height":64},"name":"step-body-02","text":"The Court noted similar boycotts aimed at particular accused persons in other cases.","geometry":"rect","lineWidth":0,"style":{"fontSize":19,"typeface":"Aptos","color":"#333333","alignment":"left"}}
{"kind":"textbox","id":"sh/ixw7mh87","slideIndex":2,"position":{"left":72,"top":484,"width":68,"height":42},"name":"step-number-03","text":"03","geometry":"rect","lineWidth":0,"style":{"fontSize":22,"typeface":"Aptos","color":"#555555","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/jy58vmps","slideIndex":2,"position":{"left":158,"top":484,"width":430,"height":34},"name":"step-head-03","text":"A question of principle","geometry":"rect","lineWidth":0,"style":{"fontSize":24,"typeface":"Aptos","color":"#111111","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/kzepo7qd","slideIndex":2,"position":{"left":158,"top":522,"width":470,"height":64},"name":"step-body-03","text":"Does professional choice belong to each advocate, or can a Bar association impose a collective refusal?","geometry":"rect","lineWidth":0,"style":{"fontSize":19,"typeface":"Aptos","color":"#333333","alignment":"left"}}
{"kind":"shape","id":"sh/50nqxc7y","slideIndex":2,"position":{"left":700,"top":178,"width":500,"height":390},"name":"right-panel","geometry":"rect","fillColor":"#D9D9D9","lineWidth":0}
