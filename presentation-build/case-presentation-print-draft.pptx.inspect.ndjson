{"kind":"textbox","id":"sh/3q1o72l8","slideIndex":4,"position":{"left":696,"top":260,"width":460,"height":30},"name":"criminal-label","text":"Rafi criminal appeal","geometry":"rect","lineWidth":0,"style":{"fontSize":23,"typeface":"Aptos","color":"#111111","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/2ps7ex4n","slideIndex":4,"position":{"left":696,"top":300,"width":460,"height":83},"name":"criminal-text","text":"State directed to pay total compensation of Rs 1.5 lakh; the FIR against Rafi and the related FIR against police were quashed under Article 142.","geometry":"rect","lineWidth":0,"style":{"fontSize":19,"typeface":"Aptos","color":"#333333","alignment":"left"}}
{"kind":"shape","id":"sh/hoj65s32","slideIndex":4,"position":{"left":696,"top":399,"width":460,"height":1},"name":"outcome-divider","geometry":"rect","fillColor":"#C8BBA8","lineWidth":0}
