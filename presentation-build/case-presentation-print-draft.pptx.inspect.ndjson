{"kind":"textbox","id":"sh/5ojud8fy","slideIndex":5,"position":{"left":1140,"top":675,"width":68,"height":22},"name":"slide-number","text":"06","geometry":"rect","lineWidth":0,"style":{"fontSize":14,"typeface":"Aptos","color":"#222222","bold":true,"alignment":"right"}}
{"kind":"textbox","id":"sh/4nat43yd","slideIndex":5,"position":{"left":72,"top":166,"width":1136,"height":96},"name":"main-idea","text":"Defending an accused safeguards the process; it does not approve the alleged conduct.","geometry":"rect","lineWidth":0,"style":{"fontSize":35,"typeface":"Aptos","color":"#222222","bold":true,"alignment":"left"}}
