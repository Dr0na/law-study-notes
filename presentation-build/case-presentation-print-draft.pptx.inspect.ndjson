{"kind":"textbox","id":"sh/9cr61w72","slideIndex":4,"position":{"left":82,"top":372,"width":500,"height":92},"name":"explanation","text":"The Court declared such resolutions null and void as contrary to constitutional norms and professional ethics.","geometry":"rect","lineWidth":0,"style":{"fontSize":22,"typeface":"Aptos","color":"#333333","alignment":"left"}}
{"kind":"shape","id":"sh/psj69c3y","slideIndex":4,"position":{"left":654,"top":174,"width":554,"height":390},"name":"outcome-panel","geometry":"rect","fillColor":"#D9D9D9","lineWidth":0}
